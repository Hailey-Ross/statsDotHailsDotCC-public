[Unit]
Description=Regenerate the GoAccess dashboard and every panel page

[Timer]
OnBootSec=2min
# The warehouse still moves every 5 minutes via hails-ingest.timer, and hails-refresh.timer redraws
# the two fast moving pages every 15. This is only how often everything else is redrawn.
OnUnitActiveSec=3h
Persistent=true

[Install]
WantedBy=timers.target
